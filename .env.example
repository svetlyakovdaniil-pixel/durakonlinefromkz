# ⚠️ СКОМПРОМЕТИРОВАННЫЕ СЕКРЕТЫ — ЗАПОЛНИТЬ НОВЫМИ ЗНАЧЕНИЯМИ
# Файл .project-config.json (содержал эти секреты) был в git-репозитории.
# ВСЕ ключи ниже считаются раскрытыми и ДОЛЖНЫ быть перевыпущены перед
# копированием этого файла в /root/app/.env на сервере.

# ── База данных (TiDB Cloud) ─────────────────────────────────────────
# СМЕНИ ПАРОЛЬ в TiDB Cloud → новое значение в DATABASE_URL
DATABASE_URL=mysql://USER:NEW_PASSWORD@gateway05.us-east-1.prod.aws.tidbcloud.com:4000/DBNAME?ssl={"rejectUnauthorized":true}

# ── Аутентификация ────────────────────────────────────────────────────
# СГЕНЕРИРУЙ НОВЫЙ (старый раскрыт):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_NEW_RANDOM_HEX

# ── Apple Sign In ─────────────────────────────────────────────────────
# Apple Developer → Keys → revoke старый ключ SHTMB76CNK → создай новый
# Скопируй приватный ключ целиком (BEGIN PRIVATE KEY ... END PRIVATE KEY)
APPLE_PRIVATE_KEY=***REMOVED***
REPLACE_WITH_NEW_APPLE_KEY
***REMOVED***

# ── Google OAuth ──────────────────────────────────────────────────────
# Google Cloud → Credentials → перевыпусти клиент-секрет
GOOGLE_CLIENT_SECRET=REPLACE_WITH_NEW_GOOGLE_SECRET

# ── Firebase ──────────────────────────────────────────────────────────
# Firebase Console → Project settings → Service accounts → Generate new
# private key → вставь содержимое JSON целиком
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"durak-online-kz"}

# ── RevenueCat ────────────────────────────────────────────────────────
# RevenueCat Dashboard → API keys → rotate secret key
REVENUECAT_SECRET_KEY=sk_REPLACE_WITH_NEW_SECRET
REVENUECAT_IOS_API_KEY=appl_REPLACE
REVENUECAT_ANDROID_API_KEY=goog_REPLACE

# ── Email-сервисы ─────────────────────────────────────────────────────
# (Если использовались — перевыпустить)
BREVO_API_KEY=REPLACE_IF_USED
RESEND_API_KEY=REPLACE_IF_USED

# ── OAuth/Manus (webdev) ──────────────────────────────────────────────
OAUTH_SERVER_URL=REPLACE_IF_USED
BUILT_IN_FORGE_API_KEY=REPLACE_IF_USED
BUILT_IN_FORGE_API_URL=REPLACE_IF_USED
OWNER_OPEN_ID=REPLACE

# ── Публичные VITE-ключи (не секреты, можно оставить) ────────────────
VITE_APP_ID=gxeBaGYcbqtwBaadFUobUt
VITE_REVENUECAT_IOS_KEY=appl_GdpfUqDfDgVtrHhTWhmzgSCogqz
VITE_REVENUECAT_ANDROID_KEY=goog_hXjnyimijBJbaxxINMZucNdxDxt
VITE_ADMOB_IOS_APP_ID=ca-app-pub-9771065396938140~8385982392
VITE_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
VITE_ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917

# ── Служебные ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
GHOST_PLAYER_COUNT=100
